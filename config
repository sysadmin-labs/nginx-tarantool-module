ngx_addon_name="ngx_http_tnt_module"

# yajl and msgpuck come from the system.  Upstream carried them as git
# submodules and preferred the bundled static libraries when they happened
# to be built; a release tarball never contains a submodule, so that path
# was only ever taken by someone building from a full clone, and the
# FreeBSD port has always linked the system libraries.  One way in, no
# second one that behaves differently.
ngx_feature="yajl and msgpuck"
ngx_feature_name=
ngx_feature_run=no
ngx_feature_incs="#include <yajl/yajl_gen.h>
#include <msgpuck.h>"
ngx_feature_path=
ngx_feature_libs="-lyajl -lmsgpuck"
ngx_feature_test="yajl_gen g = yajl_gen_alloc(NULL); (void) g;"
. auto/feature

if [ $ngx_found = no ]; then
	cat << END
$0: error: the tarantool module requires the yajl and msgpuck libraries.
END
	exit 1
fi

ngx_module_type=HTTP
ngx_module_name=$ngx_addon_name
ngx_module_incs="$ngx_addon_dir/src"
ngx_module_deps=" \
	$ngx_addon_dir/src/debug.h \
	$ngx_addon_dir/src/tp.h \
	$ngx_addon_dir/src/tp_ext.h \
	$ngx_addon_dir/src/json_encoders.h \
	$ngx_addon_dir/src/tp_transcode.h \
	"
ngx_module_srcs=" \
	$ngx_addon_dir/src/json_encoders.c \
	$ngx_addon_dir/src/tp_transcode.c \
	$ngx_addon_dir/src/ngx_http_tnt_module.c \
	"
ngx_module_libs="$ngx_feature_libs"

. auto/module
